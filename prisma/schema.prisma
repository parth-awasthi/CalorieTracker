// Prisma schema — SQLite for local dev, easy to switch to PostgreSQL for Vercel
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                         String       @id @default(cuid())
  name                       String?
  email                      String?      @unique
  emailVerified              DateTime?
  image                      String?
  age                        Int?
  weight                     Float?
  heightCm                   Float?
  gender                     String?
  activityLevel              String?
  maintenanceCalories        Float?
  targetCalories             Float?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
  accounts                   Account[]
  sessions                   Session[]
  products                   Product[]
  mealEntries                MealEntry[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id          String      @id @default(cuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  servingBase Float       @default(100)
  servingUnit String      @default("g")
  calories    Float
  protein     Float
  carbs       Float
  fat         Float
  fiber       Float       @default(0)
  sugar       Float       @default(0)
  sodium      Float       @default(0)
  imageUrl    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  mealEntries MealEntry[]

  @@index([name])
  @@index([userId])
}

model MealEntry {
  id                 String   @id @default(cuid())
  userId             String?
  user               User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date               DateTime
  mealType           String
  quantityInGrams    Float
  calculatedCalories Float
  calculatedProtein  Float
  calculatedCarbs    Float
  calculatedFat      Float
  calculatedFiber    Float
  calculatedSugar    Float
  calculatedSodium   Float
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt          DateTime @default(now())

  @@index([date])
  @@index([productId])
  @@index([userId])
}
